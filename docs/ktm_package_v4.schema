    "documentationRelativePath": {
      "description": "Contained literal documentation path, no symlink components, colons or trailing separator; percent sequences stay literal.",
      "allOf": [
        {
          "$ref": "#/definitions/safeRelativePath"
        },
        {
          "pattern": "^(?![\\s\\S]*[\\ud800-\\udfff])[^:]*[^/:]$(?![\\s\\S])"
        }
      ]
    },
    "systemLibraryDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "environments",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "description": "Exact system library name; no paths or wildcards."
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/environmentName"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
