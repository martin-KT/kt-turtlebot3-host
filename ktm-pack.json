{
  "schemaVersion": "ktm.pack.v3",
  "minimumKTMVersion": "1.2.20",
  "defaultMode": "source",
  "globalExclude": [
    "**/__pycache__/**",
    "**/*.py[cod]",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.DS_Store"
  ],
  "lists": {
    "contracts": {
      "description": "The single package contract and optional sibling runtime configuration remain at archive root.",
      "include": [
        "package.ktm.json",
        "runtime.json",
        "README.md"
      ]
    },
    "source": {
      "description": "Portable Python application source; dependencies stay KTM-managed and are not vendored.",
      "include": [
        "pyproject.toml",
        "src",
        "tests"
      ]
    },
    "compiled": {
      "description": "Optional project-owned compiled artifacts such as a custom wheel.",
      "include": [
        "dist"
      ]
    },
    "development": {
      "description": "Optional development documentation and scripts for editable source packages.",
      "include": [
        "development"
      ]
    }
  },
  "modes": {
    "source": {
      "description": "Publish the portable application source and root contracts.",
      "artifacts": [
        {
          "component": "common",
          "environment": "portable",
          "sourceRoot": ".",
          "lists": [
            "contracts",
            "source"
          ]
        }
      ]
    },
    "compiled-source": {
      "description": "Publish portable source plus optional project-owned compiled artifacts and development material. Dependencies remain KTM-managed.",
      "artifacts": [
        {
          "component": "common",
          "environment": "portable",
          "sourceRoot": ".",
          "lists": [
            "contracts",
            "source",
            "compiled",
            "development"
          ]
        }
      ]
    }
  },
  "assertions": {
    "required": [
      "package.ktm.json",
      "runtime.json",
      "src",
      "tests",
      "README.md"
    ],
    "forbidden": [
      "**/__pycache__/**",
      "**/*.py[cod]",
      "**/.env",
      "**/*.pem",
      "**/.venv/**",
      "**/site-packages/**",
      "**/kt_python_sdk-*.whl",
      "**/kt_messages-*.whl",
      "**/flatbuffers-*.whl",
      "**/libkt.so*",
      "**/.ktrees/**",
      "**/deps/**"
    ]
  },
  "limits": {
    "maximumFileBytes": 52428800,
    "maximumArchiveBytes": 209715200
  }
}
