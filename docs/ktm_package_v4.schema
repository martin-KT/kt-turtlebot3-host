{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kinematictrees.io/schemas/ktm_package_v4.schema",
  "title": "Kinematic Trees Package Contract",
  "description": "Package lifecycle contract v4. Explicit primary type, source selection outside the manifest, and preserved consumer capabilities. Runtime-instance versioning is independent.",
  "x-kt-platformCatalog": {
    "version": 1,
    "description": "Canonical platform vocabulary for consumers and authoring. This annotation does not restrict v4 validation; name identifies a build variant independently. Missing or unlisted pairs are not evidence of incompatibility. Portable environments do not imply native or browser compatibility.",
    "operatingSystems": [
      {
        "id": "linux",
        "label": "Linux",
        "aliases": []
      },
      {
        "id": "windows",
        "label": "Windows",
        "aliases": [
          "win32",
          "win64"
        ]
      },
      {
        "id": "darwin",
        "label": "macOS",
        "aliases": [
          "macos",
          "osx"
        ]
      },
      {
        "id": "android",
        "label": "Android",
        "aliases": []
      },
      {
        "id": "browser",
        "label": "Browser",
        "aliases": [
          "web"
        ]
      }
    ],
    "architectures": [
      {
        "id": "x86",
        "label": "x86",
        "detail": "32-bit Intel / AMD",
        "aliases": [
          "386",
          "i386",
          "i686",
          "ia32"
        ]
      },
      {
        "id": "x64",
        "label": "x86-64",
        "detail": "64-bit Intel / AMD",
        "aliases": [
          "amd64",
          "x86_64",
          "x86-64"
        ]
      },
      {
        "id": "arm",
        "label": "ARM32",
        "detail": "32-bit ARM",
        "aliases": [
          "arm32",
          "armv7",
          "armv7l",
          "armhf"
        ]
      },
      {
        "id": "arm64",
        "label": "ARM64",
        "detail": "64-bit ARM",
        "aliases": [
          "aarch64"
        ]
      },
      {
        "id": "wasm32",
        "label": "WASM",
        "detail": "WebAssembly (32-bit memory model)",
        "aliases": [
          "wasm"
        ]
      }
    ],
    "pairs": [
      {
        "os": "linux",
        "arch": "x86"
      },
      {
        "os": "linux",
        "arch": "x64"
      },
      {
        "os": "linux",
        "arch": "arm"
      },
      {
        "os": "linux",
        "arch": "arm64"
      },
      {
        "os": "windows",
        "arch": "x86"
      },
      {
        "os": "windows",
        "arch": "x64"
      },
      {
        "os": "windows",
        "arch": "arm64"
      },
      {
        "os": "darwin",
        "arch": "x64"
      },
      {
        "os": "darwin",
        "arch": "arm64"
      },
      {
        "os": "android",
        "arch": "x86"
      },
      {
        "os": "android",
        "arch": "x64"
      },
      {
        "os": "android",
        "arch": "arm"
      },
      {
        "os": "android",
        "arch": "arm64"
      },
      {
        "os": "browser",
        "arch": "wasm32"
      }
    ]
  },
  "definitions": {
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$(?![\\s\\S])",
      "not": {
        "enum": [
          "node_modules",
          "favicon.ico"
        ]
      }
    },
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "exactSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+build\\.([1-9][0-9]*))?$(?![\\s\\S])",
      "minLength": 5,
      "maxLength": 256
    },
    "npmSemverSelector": {
      "type": "string",
      "description": "npm-style SemVer dependency selector. Supports exact/core SemVer, exact +build.N pins, tilde, caret, and whitespace-separated comparator sets. Build metadata is allowed only on exact pins; unbounded latest/* and OR ranges are intentionally excluded for lifecycle package dependencies.",
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+build\\.(?:[1-9][0-9]*))?|[~^](?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?|(?:<|<=|>|>=)\\s*(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\s+(?:<|<=|>|>=)\\s*(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?)*)$(?![\\s\\S])",
      "minLength": 5,
      "maxLength": 256
    },
    "dependencyVersionSelector": {
      "description": "Dependency version request. Exact immutable versions must use registry build metadata (+build.N); non-exact selectors are resolved by KTM into exact immutable versions and recorded in locks/receipts.",
      "anyOf": [
        {
          "$ref": "#/definitions/exactSemver"
        },
        {
          "$ref": "#/definitions/npmSemverSelector"
        }
      ]
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$(?![\\s\\S])"
    },
    "safeBasename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?![A-Za-z]:)(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?!\\.\\.?$)(?!.*[\\\\/])[^\\u0000]+$(?![\\s\\S])"
    },
    "sha512SRI": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]{86}==$(?![\\s\\S])"
    },
    "developmentV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watcherBackend": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "polling"
          ]
        },
        "failureBehavior": {
          "type": "string",
          "enum": [
            "retain-last-known-good"
          ]
        },
        "debounceMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "settleMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 30000
        },
        "pollIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "restartGraceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "restartBackoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "retainedRevisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "metadataV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "version",
        "author",
        "packageType"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "namespace": {
          "$ref": "#/definitions/packageName"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "$ref": "#/definitions/exactSemver"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "license": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "git"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "bugs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "readme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152,
          "description": "Packaged Markdown text. Shared semantics require nonblank strict UTF-8 without BOM/C0/C1 controls (except tab/CR/LF), at most 2 MiB bytes. Preserve exact CR/LF and final newline. Required consumer/release, optional source before materialization. Shape-only validation does not establish text semantics or staged agreement."
        },
        "readmeFilename": {
          "$ref": "#/definitions/documentationRelativePath",
          "description": "Contained package-root-relative literal Markdown path, never URL decoded. Required consumer/release; decoded staged file must equal readme."
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "disk",
            "network"
          ],
          "properties": {
            "cpu": {
              "type": "number",
              "minimum": 0.1
            },
            "memory": {
              "type": "integer",
              "minimum": 1
            },
            "disk": {
              "type": "integer",
              "minimum": 1
            },
            "network": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "publishLocation": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "description": "Delivery model: local content or remotely provided service. Not privacy or registry URL."
        },
        "packageType": {
          "description": "Primary package purpose used for discovery and selecting appropriate handling. Exported capabilities may span multiple uses.",
          "enum": [
            "process",
            "runtime",
            "library",
            "data_types",
            "studio_extension",
            "robot",
            "tool",
            "template"
          ]
        },
        "media": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/mediaItem"
          },
          "description": "Optional ordered images/videos; empty is valid. Package sources/posters/captions must ship in required common selected content, inventoried at Pack. No arbitrary embeds."
        },
        "releaseMaturity": {
          "type": "string",
          "enum": [
            "experimental",
            "alpha",
            "beta",
            "rc",
            "stable"
          ],
          "description": "Developer release maturity label; independent of version selection and visibility. Absence means unspecified, never inferred stable."
        }
      }
    },
    "dataflowInputV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "datatype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$(?![\\s\\S])"
        },
        "datatype": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "dataflowOutputV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "datatype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$(?![\\s\\S])"
        },
        "datatype": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "dataflowV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dataflowInputV4"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dataflowOutputV4"
          }
        }
      }
    },
    "runtimeV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk"
      ],
      "properties": {
        "sdk": {
          "type": "string",
          "enum": [
            "python",
            "csharp",
            "go",
            "rust",
            "cpp",
            "native",
            "c-abi-v1"
          ]
        },
        "sdkVersion": {
          "type": "string"
        },
        "languageVersion": {
          "type": "string"
        },
        "adapterOutputs": {
          "description": "SDK-template-owned mapping from opaque adapter staging slot names to project-relative roots owned by the adapter.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
          },
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/definitions/safeRelativePath"
              },
              {
                "pattern": "[^/]$(?![\\s\\S])"
              }
            ]
          }
        }
      }
    },
    "configSchemaV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/configTypedPropertyV4"
              },
              {
                "$ref": "#/definitions/configUnionPropertyV4"
              }
            ]
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "configTypedPropertyV4": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "enum": {
          "type": "array"
        },
        "items": {
          "type": "object"
        },
        "x-kt-mutability": {
          "type": "string",
          "enum": [
            "static",
            "dynamic"
          ]
        }
      },
      "not": {
        "required": [
          "oneOf"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "x-kt-mutability": {
                "const": "dynamic"
              }
            },
            "required": [
              "x-kt-mutability"
            ]
          },
          "then": {
            "required": [
              "default"
            ]
          }
        }
      ]
    },
    "configUnionBranchV4": {
      "description": "Strict typed subset for configuration union branches. Unsupported operators fail admission instead of becoming ignored runtime constraints.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "$ref": "#/definitions/configUnionBranchV4"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/configUnionBranchV4"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "configUnionPropertyV4": {
      "description": "An explicit oneOf union without a competing sibling type. Defaults remain parent annotations; branch defaults are never selected speculatively.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneOf"
      ],
      "properties": {
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/configUnionBranchV4"
          }
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "x-kt-mutability": {
          "enum": [
            "static",
            "dynamic"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "x-kt-mutability": {
                "const": "dynamic"
              }
            },
            "required": [
              "x-kt-mutability"
            ]
          },
          "then": {
            "required": [
              "default"
            ]
          }
        }
      ]
    },
    "serviceV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints",
        "authentication"
      ],
      "properties": {
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api"
          ],
          "properties": {
            "api": {
              "type": "string",
              "format": "uri"
            },
            "health": {
              "type": "string",
              "format": "uri"
            },
            "docs": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "required"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "none",
                "bearer",
                "api_key",
                "oauth2"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "envVar": {
              "type": "string"
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "period"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 1
            },
            "period": {
              "type": "string",
              "enum": [
                "second",
                "minute",
                "hour",
                "day"
              ]
            }
          }
        }
      }
    },
    "hostRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libc"
      ],
      "properties": {
        "libc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "minimumVersion"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "enum": [
                "glibc"
              ]
            },
            "minimumVersion": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
            }
          }
        }
      }
    },
    "pathArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/runtimeExportPath"
      }
    },
    "pythonRuntimePackageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "wheel"
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/definitions/runtimeExportPath"
            },
            {
              "pattern": "\\.whl$(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "pythonRuntimePackageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importNames",
        "requiresPython"
      ],
      "properties": {
        "importNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$(?![\\s\\S])"
          }
        },
        "requiresPython": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^(?:(?:~=|==|!=|<=|>=|<|>)?(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){1,2})(?:\\s*,\\s*(?:(?:~=|==|!=|<=|>=|<|>)?(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){1,2}))*$(?![\\s\\S])"
        }
      }
    },
