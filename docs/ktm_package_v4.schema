                "pattern": "^(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$(?![\\s\\S])"
              }
            },
            "goVersion": {
              "type": "string",
              "pattern": "^1\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$(?![\\s\\S])"
            }
          }
        }
      }
    },
