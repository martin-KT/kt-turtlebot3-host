    "compilerToolchain": {
      "oneOf": [
        {
          "$ref": "#/definitions/rustCompilerToolchain"
        }
      ]
    },
    "compilerToolchainArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/compilerToolchain"
      }
    },
    "codegenDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "schemaVersion",
        "path"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "go",
            "cpp"
          ]
        },
        "schemaVersion": {
          "const": 1
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/definitions/runtimeExportPath"
            },
            {
              "pattern": "\\.json$(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "codegenDescriptorArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/codegenDescriptor"
      }
    },
    "sdkAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk",
        "protocol",
        "executablePath",
        "capabilities"
      ],
      "properties": {
        "sdk": {
          "description": "Opaque SDK identifier matched exactly against runtime.sdk.",
          "$ref": "#/definitions/packageName"
        },
        "protocol": {
          "const": "kt.sdk-adapter.v1"
        },
        "executablePath": {
          "description": "Contained, integrity-covered executable path inside this package environment.",
          "$ref": "#/definitions/runtimeExportPath"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$(?![\\s\\S])"
          }
        }
      }
    },
    "sdkAdapterArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/sdkAdapter"
      }
    },
    "runtimeExports": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "binPaths": {
          "$ref": "#/definitions/pathArray"
        },
        "libraryPaths": {
          "$ref": "#/definitions/pathArray"
        },
        "includePaths": {
          "$ref": "#/definitions/pathArray"
        },
        "pkgConfigPaths": {
          "$ref": "#/definitions/pathArray"
        },
        "cmakePrefixPaths": {
          "$ref": "#/definitions/pathArray"
        },
        "runtimePackages": {
          "$ref": "#/definitions/runtimePackageArray"
        },
        "languageRuntimes": {
          "description": "Contained language interpreter exports. Consumers must select these from the resolved package graph rather than searching the host PATH.",
          "$ref": "#/definitions/languageRuntimeArray"
        },
        "compilerToolchains": {
          "description": "Contained compiler and package-manager exports selected from the resolved package graph without consulting ambient host toolchains.",
          "$ref": "#/definitions/compilerToolchainArray"
        },
        "codegenDescriptors": {
          "description": "Contained declarative datatype descriptor documents consumed by package-agnostic code generators without executing dependency code.",
          "$ref": "#/definitions/codegenDescriptorArray"
        },
        "sdkAdapters": {
          "description": "Contained SDK-owned executables implementing the language-neutral kt.sdk-adapter.v1 process contract.",
          "$ref": "#/definitions/sdkAdapterArray"
        },
        "releaseManifest": {
          "$ref": "#/definitions/runtimeReleaseManifest"
        },
        "entrypoints": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/definitions/entrypoint"
          }
        },
        "descriptors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/typedDescriptor"
          }
        }
      }
    },
    "structuredCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runArgument": {
      "description": "One literal argv element or one fixed KTM path placeholder. Placeholders are substituted only when the entire argument matches.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "${KTM_PACKAGE_MANIFEST}",
            "${KTM_RUNTIME_DOCUMENT}"
          ]
        },
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])",
          "not": {
            "pattern": "\\$\\{"
          }
        }
      ]
    },
    "runCommand": {
      "description": "Shell-free run invocation. The program is resolved from the selected package/SDK environment and args are passed directly without shell parsing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)(?:[Ss][Hh]|[Bb][Aa][Ss][Hh]|[Dd][Aa][Ss][Hh]|[Zz][Ss][Hh]|[Ff][Ii][Ss][Hh]|[Cc][Mm][Dd]|[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]|[Pp][Ww][Ss][Hh]|[Ee][Nn][Vv]|[Ss][Uu][Dd][Oo]|[Ss][Uu]|[Dd][Oo][Aa][Ss]|[Pp][Kk][Ee][Xx][Ee][Cc])(?:\\.[Ee][Xx][Ee])?$(?![\\s\\S])"
          }
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/runArgument"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "clean",
            "build",
            "test",
            "run",
            "install"
          ]
        },
        "command": {
          "$ref": "#/definitions/structuredCommand"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "extends": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+$(?![\\s\\S])"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "description": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        },
        "compose": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "commands"
                ]
              },
              {
                "required": [
                  "extends"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "commands"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "extends"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "extends"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "commands"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "action",
              "command"
            ],
            "properties": {
              "action": {
                "const": "run"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/definitions/runCommand"
              }
            }
          }
        }
      ]
    },
    "runEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "recipes"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/environmentName"
        },
        "type": {
          "type": "string",
          "enum": [
            "native",
            "container",
            "portable"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "hostRequirements": {
          "$ref": "#/definitions/hostRequirements"
        },
        "runtimeExports": {
          "$ref": "#/definitions/runtimeExports"
        },
        "recipes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/recipe"
          }
        },
        "testedPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/testedPlatform"
          }
        },
        "componentExports": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/componentId"
          },
          "additionalProperties": {
            "$ref": "#/definitions/runtimeExports"
          },
          "description": "Capabilities exposed only by the corresponding selected component."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "portable"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "os"
                  ]
                },
                {
                  "required": [
                    "arch"
                  ]
                },
                {
                  "required": [
                    "hostRequirements"
                  ]
                }
              ]
            },
            "properties": {
              "runtimeExports": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "binPaths"
                      ]
                    },
                    {
                      "required": [
                        "libraryPaths"
                      ]
                    },
                    {
                      "required": [
                        "includePaths"
                      ]
                    },
                    {
                      "required": [
                        "pkgConfigPaths"
                      ]
                    },
                    {
                      "required": [
                        "cmakePrefixPaths"
                      ]
                    },
                    {
                      "required": [
                        "languageRuntimes"
                      ]
                    },
                    {
                      "required": [
                        "compilerToolchains"
                      ]
                    }
                  ]
                }
              },
              "componentExports": {
                "additionalProperties": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "binPaths"
                        ]
                      },
                      {
                        "required": [
                          "libraryPaths"
                        ]
                      },
                      {
                        "required": [
                          "includePaths"
                        ]
                      },
                      {
                        "required": [
                          "pkgConfigPaths"
                        ]
                      },
                      {
                        "required": [
                          "cmakePrefixPaths"
                        ]
                      },
                      {
                        "required": [
                          "languageRuntimes"
                        ]
                      },
                      {
                        "required": [
                          "compilerToolchains"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "os",
              "arch"
            ]
          }
        },
        {
          "if": {
            "required": [
              "hostRequirements"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "native"
              },
              "os": {
                "const": "linux"
              }
            }
          }
        }
      ]
    },
    "packageDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "version"
      ],
      "properties": {
        "owner": {
          "$ref": "#/definitions/packageName"
        },
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "version": {
          "$ref": "#/definitions/dependencyVersionSelector"
        },
        "environmentSelector": {
          "description": "Select the dependency environment by projecting the resolution request's normalized target through this edge.",
          "const": "target"
        },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/environmentName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/environmentName"
          }
        },
        "whenComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/componentId"
          },
          "description": "Activate this dependency only when one of these components is selected; absent means always active.",
          "minItems": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "environments"
          ],
          "not": {
            "required": [
              "environmentSelector"
            ]
          }
        },
        {
          "required": [
            "environmentSelector"
          ],
          "not": {
            "required": [
              "environments"
            ]
          }
        }
      ]
    },
    "dependenciesV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/systemLibraryDependency"
              }
            ]
          },
          "uniqueItems": true
        },
        "packages": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/packageDependency"
              },
              "uniqueItems": true
            }
          ]
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "resourcesV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "protocol"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "gpu": {
          "type": "boolean"
        },
        "x11": {
          "type": "boolean"
        }
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sbom": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "provenance": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "linkAudit": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "dependencyLock": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "buildEnvironment": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "buildReceipt": {
          "$ref": "#/definitions/runtimeExportPath"
        },
        "adoptionReceipt": {
          "$ref": "#/definitions/runtimeExportPath"
        }
      },
      "minProperties": 1
    },
    "strictArtifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "url",
        "integrity",
        "size",
        "format",
        "component",
        "consumerManifestDigest",
        "inventory"
      ],
      "properties": {
        "environment": {
          "$ref": "#/definitions/environmentName"
        },
        "url": {
          "$ref": "#/definitions/artifactUrlReference"
        },
        "integrity": {
          "$ref": "#/definitions/sha512SRI"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "tar.gz",
            "zip",
            "deb",
            "rpm"
          ]
        },
        "sidecars": {
          "$ref": "#/definitions/sidecars"
        },
        "component": {
          "$ref": "#/definitions/componentId"
        },
        "consumerManifestDigest": {
          "$ref": "#/definitions/sha256Digest"
        },
        "inventory": {
          "$ref": "#/definitions/inventoryReference"
        }
      }
    },
    "localArtifact": {
      "$ref": "#/definitions/strictArtifactBase"
    },
    "externalArtifact": {
      "$ref": "#/definitions/strictArtifactBase"
    },
    "legacyArtifact": {
      "$ref": "#/definitions/strictArtifactBase"
    },
    "distributionV4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/strictArtifactBase"
          },
          "uniqueItems": true
        },
        "urlStrategy": {
          "type": "string",
          "enum": [
            "local-relative",
            "external-base",
            "registry-authorized"
          ]
        },
        "urlBase": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+/?$(?![\\s\\S])"
        },
        "registry": {
          "type": "string",
          "format": "uri"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifactComponent"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "urlStrategy": {
                "const": "local-relative"
              }
            },
            "required": [
              "urlStrategy"
            ]
          },
          "then": {
            "properties": {
              "packages": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/strictArtifactBase"
                    },
                    {
                      "properties": {
                        "url": {
                          "$ref": "#/definitions/safeRelativePath"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "urlStrategy": {
                "const": "external-base"
              }
            },
            "required": [
              "urlStrategy"
            ]
          },
          "then": {
            "required": [
              "urlBase"
            ],
            "properties": {
              "packages": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/strictArtifactBase"
                    },
                    {
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://[^\\s\\u0000-\\u001F\\u007F\\\\]+$(?![\\s\\S])"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "lifecyclePackageV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "metadata",
        "runEnvironments"
      ],
      "properties": {
        "schemaVersion": {
          "const": "4"
        },
        "metadata": {
          "$ref": "#/definitions/metadataV4"
        },
        "dataflow": {
          "$ref": "#/definitions/dataflowV4"
        },
        "runtime": {
          "$ref": "#/definitions/runtimeV4"
        },
        "development": {
          "$ref": "#/definitions/developmentV4"
        },
        "config": {
          "$ref": "#/definitions/configSchemaV4"
        },
        "service": {
          "$ref": "#/definitions/serviceV4"
        },
        "runEnvironments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/runEnvironment"
          }
        },
        "dependencies": {
          "$ref": "#/definitions/dependenciesV4"
        },
        "resources": {
          "$ref": "#/definitions/resourcesV4"
        },
        "distribution": {
          "$ref": "#/definitions/distributionV4"
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generates",
            "descriptor"
          ],
          "properties": {
            "generates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "process",
                    "runtime",
                    "library",
                    "data_types",
                    "studio_extension",
                    "robot",
                    "tool",
                    "template"
                  ]
                },
                "language": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Template language selector; runtime-only. Actual availability is discovered from template packages."
                }
              },
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "process",
                      "runtime"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "language"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "language"
                  ]
                }
              }
            },
            "descriptor": {
              "$ref": "#/definitions/descriptorReference"
            }
          },
          "description": "Template discovery metadata and pointer to its operational descriptor. Rendering and testing controls belong in the referenced file."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metadata": {
                "required": [
                  "publishLocation"
                ],
                "properties": {
                  "publishLocation": {
                    "const": "remote"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metadata": {
                "properties": {
                  "packageType": {
                    "enum": [
                      "process",
                      "runtime"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "runtime"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metadata": {
                "properties": {
                  "packageType": {
                    "const": "template"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "template"
            ]
          },
          "else": {
            "not": {
              "required": [
                "template"
              ]
            }
          }
        }
      ]
    },
    "testedPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "minVersion",
        "maxVersion"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
        },
        "minVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
        },
        "maxVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
        }
      }
    },
    "runtimeExportPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$(?![\\s\\S])",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "artifactUrlReference": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])[^\\s\\u0000-\\u001F\\u007F\\\\]+$(?![\\s\\S])"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])",
      "maxLength": 128
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "descriptorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "path"
      ],
      "properties": {
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/safeRelativePath"
        }
      }
    },
    "entrypoint": {
      "description": "Named explicit invocation: package-relative program and literal argument vector. Declaration never implies execution on install.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ],
      "properties": {
        "program": {
          "$ref": "#/definitions/runCommand/properties/program"
        },
        "args": {
          "$ref": "#/definitions/runCommand/properties/args"
        },
        "workingDirectory": {
          "$ref": "#/definitions/safeRelativePath"
        },
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "name",
            "entrypoint"
          ],
          "properties": {
            "owner": {
              "$ref": "#/definitions/packageName"
            },
            "name": {
              "$ref": "#/definitions/packageName"
            },
            "entrypoint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])",
              "maxLength": 128
            }
          }
        }
      }
    },
    "typedDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaId",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])",
          "maxLength": 128
        },
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/safeRelativePath"
        }
      }
    },
    "artifactComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "default",
        "requires"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/componentId"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/componentId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "inventoryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/safeRelativePath"
        },
        "sha256": {
          "$ref": "#/definitions/sha256Digest"
        }
      }
    },
    "sourcePackageV4": {
      "description": "Authoring view: keep recipes/development, declare components, but do not author generated release records. File selection stays in ktm-pack.json.",
      "allOf": [
        {
          "$ref": "#/definitions/lifecyclePackageV4"
        },
        {
          "properties": {
            "distribution": {
              "properties": {
                "packages": false,
                "urlStrategy": false,
                "urlBase": false,
                "registry": false
              }
            }
          }
        }
      ]
    },
    "publishedPackageV4": {
      "description": "Common consumer/release view: no development block or build/test/install/clean recipes. Launch commands remain structured and explicit.",
      "allOf": [
        {
          "$ref": "#/definitions/lifecyclePackageV4"
        },
        {
          "not": {
            "required": [
              "development"
            ]
          },
          "properties": {
            "runEnvironments": {
              "items": {
                "properties": {
                  "recipes": {
                    "items": {
                      "required": [
                        "command"
                      ],
                      "properties": {
                        "action": {
                          "const": "run"
                        },
                        "commands": false,
                        "extends": false
                      }
                    }
                  }
                }
              }
            },
            "metadata": {
              "required": [
                "readme",
                "readmeFilename"
              ]
            }
          }
        }
      ]
    },
    "consumerPackageV4": {
      "description": "Manifest inside the archive. Retains capability/component declarations, not external artifact records or evidence hashes that would create self-hash cycles.",
      "allOf": [
        {
          "$ref": "#/definitions/publishedPackageV4"
        },
        {
          "properties": {
            "distribution": {
              "properties": {
                "packages": false,
                "urlStrategy": false,
                "urlBase": false,
                "registry": false
              }
            }
          }
        }
      ]
    },
    "releasePackageV4": {
      "description": "External consumer projection plus finalized artifact index. File-backed releases require at least one artifact; a remote service need not invent one.",
      "allOf": [
        {
          "$ref": "#/definitions/publishedPackageV4"
        },
        {
          "if": {
            "properties": {
              "metadata": {
                "required": [
                  "publishLocation"
                ],
                "properties": {
                  "publishLocation": {
                    "const": "remote"
                  }
                }
              }
            }
          },
          "then": {},
          "else": {
            "required": [
              "distribution"
            ],
            "properties": {
              "distribution": {
                "required": [
                  "packages"
                ],
                "properties": {
                  "packages": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "documentationHttpsURL": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "pattern": "^(?![\\s\\S]*[\\ud800-\\udfff])https://[^/?#@\\s]+(?:/[^?#\\s]*)?$(?![\\s\\S])"
    },
    "mediaSource": {
      "description": "Offline direct-asset reference. Literal package-root path, no percent decoding. External HTTPS: no userinfo/query/fragment, no provider watch/embed pages or remote fetch. MIME is a declaration, not byte-format proof.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "mediaType"
          ],
          "properties": {
            "kind": {
              "const": "package"
            },
            "path": {
              "$ref": "#/definitions/documentationRelativePath"
            },
            "mediaType": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif",
                "image/avif",
                "video/mp4",
                "video/webm",
                "video/ogg",
                "text/vtt"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url",
            "mediaType"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "url": {
              "$ref": "#/definitions/documentationHttpsURL"
            },
            "mediaType": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/gif",
                "image/avif",
                "video/mp4",
                "video/webm",
                "video/ogg",
                "text/vtt"
              ]
            }
          }
        }
      ]
    },
